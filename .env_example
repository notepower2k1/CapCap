# Copy this file to .env only when you need to configure a provider manually.
# Most settings are available in CapCap's Settings dialog.

# Translation provider: google, google_ai_studio, openai, or ollama
OPENAI_PROVIDER=google
AI_POLISHER_PROVIDER=google

# OpenAI / Ollama configuration
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Google AI Studio (Gemini) configuration
# GOOGLE_AI_STUDIO_API_KEY=
# GOOGLE_AI_STUDIO_MODEL=gemini-3.7-flash
# GOOGLE_AI_STUDIO_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OCR crop configuration. The Subtitle Source itself is saved per project,
# not in this file.
OCR_SUBTITLE_REGION=bottom
# Auto adapts to video duration. Choose 2, 3, or 4 for long videos with
# subtitle flashes shorter than the automatic sampling interval.
OCR_SAMPLING_FPS=auto
# OCR_CROP_RATIO=0.25
# OCR_SUBTITLE_RECT=0.0,0.75,1.0,0.25

# Optional remote API mode
CAPCAP_REMOTE_API_URL=http://127.0.0.1:8765
CAPCAP_REMOTE_API_TOKEN=
CAPCAP_REMOTE_API_HOST=0.0.0.0
CAPCAP_REMOTE_API_PORT=8765
CAPCAP_REMOTE_API_TIMEOUT=600
CAPCAP_QUIET=false

# Optional GPU Whisper tuning. Leave unset to use the app defaults.
# CAPCAP_WHISPER_DEVICE=cpu
# CAPCAP_WHISPER_GPU_BATCHED=0
# CAPCAP_WHISPER_GPU_BATCH_SIZE=auto
